.env
secrets/
.streamlit/secrets.toml
data/state.db
# Public dataset copies, conversions and labels — never commit
data/external/
logs/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
build/
dist/

# OS / editors
.DS_Store
.idea/
.vscode/
