# 이 파일을 .env로 복사해 값을 채우세요. .env는 커밋하지 않습니다.

# --- LLM (공유) ---
GEMINI_API_KEY=
# 비어 있으면 smoke_test가 사용 가능한 모델 목록을 출력한다
GEMINI_MODEL_PRIMARY=
# 쉼표 구분, 순서대로 시도
GEMINI_MODEL_FALLBACKS=
LLM_TIMEOUT_SEC=60
# true면 LLM 호출 없이 규칙 기반 추출 (시연용)
FORCE_FALLBACK=false

# --- Google ---
# 파일 경로, JSON 문자열, base64 문자열 모두 허용. 상대 경로는 저장소 루트 기준
GOOGLE_SERVICE_ACCOUNT_JSON=secrets/google-service-account.json
GCAL_CALENDAR_ID=
GSHEETS_SPREADSHEET_ID=

# --- Slack ---
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# --- 운영 ---
# sqlite | sheets
STATE_BACKEND=sqlite
SQLITE_PATH=data/state.db
# true면 Calendar/Slack 호출 대신 페이로드를 로그와 UI에 표시
ACTIONS_DRY_RUN=true
TIMEZONE=Asia/Seoul
REMINDER_STAGES=D-1,D-day,overdue
MEETING_MAX_CHARS=100000
ROSTER_PATH=data/roster.yaml

# --- 임베딩 (생성 모델 설정과 별개) ---
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=3072
GEMINI_EMBED_QUERY_TASK=QUESTION_ANSWERING

# --- 규정 RAG ---
RAG_TOP_K=6
# 개발 세트로 정한 v2 하한(docs/DECISIONS.md, 2026-10-10 D3). 명백한 범위 밖만 모델 호출 없이 거른다. v1은 0.705
RAG_MIN_SCORE=0.636
# vector | bm25 | rrf — 개발 세트로 정한 기본값은 vector
RAG_RETRIEVAL_MODE=vector
RAG_MAX_AGENT_STEPS=4
REG_INDEX_DIR=data/index/regulations
# true면 구축 작업의 호출 예산(생성 12, 질문 임베딩 30, 문서 12만 토큰 추정)을 넘는 호출을 막는다. 사용량은 늘 기록한다
RAG_ENFORCE_BUDGET=true

# --- 법제처 Open API ---
LAW_API_OC=
LAW_API_BASE=https://www.law.go.kr/DRF
